# Copy to .env (never commit it) and export before running the jobs, e.g.:
#   set -a; source .env; set +a
#
# None of these are passwords. The IB Gateway login is entered by hand in the Gateway app,
# and the code never stores broker credentials.

# Contact e-mail sent in the User-Agent to SEC EDGAR and FRED (both ask for one).
FH_CONTACT_EMAIL=you@example.com

# Optional: name shown on the dashboard and in the research pack.
FH_FUND_NAME="Fund House — US Equity Paper Fund"

# IB Gateway (paper). 4002 is the Gateway paper port; the code refuses live ports and non-paper accounts.
FH_IB_HOST=127.0.0.1
FH_IB_PORT=4002
